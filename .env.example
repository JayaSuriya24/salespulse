# Documentation of supported environment variables. The app does NOT read this file:
# export the variables in your shell (or set them in Render / docker compose).
APP_ENV=development
DATA_DIR=data/processed
ARTIFACT_DIR=artifacts
RAW_DIR=data/raw
MLFLOW_TRACKING_URI=./mlruns

# REQUIRED to use the M5 upload (POST /api/v1/datasets/m5/upload). At least 16 characters.
# Leave unset to keep the endpoint disabled (it then returns 503). Never commit a real value.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
M5_UPLOAD_TOKEN=

# Optional: size cap in MB for the generic CSV preview upload (default 50).
# MAX_UPLOAD_MB=50
